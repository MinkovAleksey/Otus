---
apiVersion: v1
kind: Secret
metadata:
  name: opensearch-internal-users
  namespace: es
type: Opaque
stringData:
  internal_users.yml: |
    ---
    # Artur's version
    # This is the internal user database
    # The hash value is a bcrypt hash and can be generated with plugin/tools/hash.sh
    
    _meta:
      type: "internalusers"
      config_version: 2
    
    # Define your internal users here
    
    ## Demo users
    
    admin:
      hash: "$2a$05$05oPcBSGdHxCC1qo9s4cJehyhlQoJXZBZwy8GCZOrjyPaWKwcWS0W"
      reserved: true
      backend_roles:
      - "admin"
      description: "Demo admin user"
    
    anomalyadmin:
      hash: "$2a$05$05oPcBSGdHxCC1qo9s4cJehyhlQoJXZBZwy8GCZOrjyPaWKwcWS0W"
      reserved: false
      opendistro_security_roles:
      - "anomaly_full_access"
      description: "Demo anomaly admin user, using internal role"
    
    kibanaserver:
      hash: "$2a$05$05oPcBSGdHxCC1qo9s4cJehyhlQoJXZBZwy8GCZOrjyPaWKwcWS0W"
      reserved: true
      description: "Demo OpenSearch Dashboards user"
    
    kibanaro:
      hash: "$2a$05$05oPcBSGdHxCC1qo9s4cJehyhlQoJXZBZwy8GCZOrjyPaWKwcWS0W"
      reserved: false
      backend_roles:
      - "kibanauser"
      - "readall"
      attributes:
        attribute1: "value1"
        attribute2: "value2"
        attribute3: "value3"
      description: "Demo OpenSearch Dashboards read only user, using external role mapping"
        
    logstash:
      hash: "$2a$05$05oPcBSGdHxCC1qo9s4cJehyhlQoJXZBZwy8GCZOrjyPaWKwcWS0W"
      reserved: false
      backend_roles:
      - "logstash"
      description: "Demo logstash user, using external role mapping"
    
    readall:
      hash: "$2a$05$05oPcBSGdHxCC1qo9s4cJehyhlQoJXZBZwy8GCZOrjyPaWKwcWS0W"
      reserved: false
      backend_roles:
      - "readall"
      description: "Demo readall user, using external role mapping"
    
    snapshotrestore:
      hash: "$2a$05$05oPcBSGdHxCC1qo9s4cJehyhlQoJXZBZwy8GCZOrjyPaWKwcWS0W"
      reserved: false
      backend_roles:
      - "snapshotrestore"
      description: "Demo snapshotrestore user, using external role mapping"
